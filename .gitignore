# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Python build / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
.saber-venv/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# Environment / secrets
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*.kdbx

# Local configuration overrides
config/*.local.yaml
config/*.local.yml
config/*.secret.yaml
config/*.secret.yml

# SABER runtime data
sessions/*
!sessions/.gitkeep
output/*
!output/.gitkeep
runs/*
!runs/.gitkeep

# Evidence and generated reports
reports/
evidence/
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.log
*.jsonl

# Generated report artifacts
*.pdf
*.xlsx
*.csv

# Keep checked-in examples despite report artifact rules
!examples/sample_executive_summary.pdf
!examples/sample_technical_report.pdf
!examples/sample_findings.json
!examples/sample_scope.yaml

# Docker / local sandbox artifacts
.docker/
docker/*.tar
docker/*.img

# OS/editor files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Misc local files
*.tmp
*.bak
*.orig