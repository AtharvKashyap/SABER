{% if reports %}
<div class="table-wrap">
  <table class="data">
    <thead>
      <tr>
        <th>Report</th>
        <th>Format</th>
        {% if show_mission %}<th>Mission</th>{% endif %}
        <th>Written</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
    {% for row in reports %}
      <tr>
        <td class="num wrap">{{ row.path or row.report_id }}</td>
        <td>{{ row.report_type or "—" }}</td>
        {% if show_mission %}
        <td class="num"><a href="/ui/sessions/{{ row.session_id }}">{{ row.session_id }}</a></td>
        {% endif %}
        <td class="num">{{ row.created_at | shortdate }}</td>
        <td>
          <a class="btn btn-ghost btn-sm" href="/reports/{{ row.report_id }}/download">Download</a>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<div class="empty">
  <strong>No reports yet</strong>
  SABER writes the technical report and executive summary from final mission state once a
  mission completes or stops.
</div>
{% endif %}
