

# ==========================================================
# SABER Environment Example
# Copy this file to .env and fill in local values.
# Never commit your real .env file.
# ==========================================================

# ----------------------------------------------------------
# LLM / Agent Orchestration
# ----------------------------------------------------------

# Agent mode used by CLI/runtime.
# deterministic = current rule-based fallback, no API key required.
# llm = use the configured LLM client for agent decisions.
SABER_AGENT_MODE=deterministic

# LLM provider. Use openai_compatible for OpenAI, OpenRouter, local LiteLLM,
# vLLM, Ollama OpenAI-compatible gateways, etc.
# Supported values: disabled, openai_compatible
SABER_LLM_PROVIDER=disabled

# API key for the configured LLM provider.
# Examples:
#   OpenAI:     sk-...
#   OpenRouter: sk-or-...
SABER_LLM_API_KEY=

# OpenAI-compatible base URL.
# OpenAI:     https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Local:      http://127.0.0.1:11434/v1 or http://127.0.0.1:4000/v1
SABER_LLM_BASE_URL=https://api.openai.com/v1

# Model name passed directly to the provider.
# OpenAI example: gpt-4o-mini
# OpenRouter example: anthropic/claude-3.5-sonnet
# Local example: llama3.1:8b
SABER_LLM_MODEL=gpt-4o-mini

# Sampling/limits for agent decisions.
SABER_LLM_TEMPERATURE=0.1
SABER_LLM_MAX_TOKENS=2000
SABER_LLM_TIMEOUT_SECONDS=60

# Maximum number of retry attempts for transient LLM/API failures.
SABER_LLM_MAX_RETRIES=3

# Optional OpenRouter metadata headers.
SABER_LLM_HTTP_REFERER=
SABER_LLM_APP_TITLE=SABER

# ----------------------------------------------------------
# Runtime / Session Paths
# ----------------------------------------------------------

# Where SABER writes resumable session state.
SABER_SESSION_DIR=sessions

# Where SABER writes raw evidence, screenshots, and generated artifacts.
SABER_OUTPUT_DIR=output

# Default log level: DEBUG, INFO, WARNING, ERROR.
SABER_LOG_LEVEL=INFO

# ----------------------------------------------------------
# Docker Sandbox
# ----------------------------------------------------------

# Sandbox image built by scripts/build_sandbox_image.sh.
SABER_SANDBOX_IMAGE=saber/sandbox:kali-last-release

# If true, exploitation/post-exploitation actions pause for operator approval by default.
# Can be overridden by CLI flags.
SABER_INTERACTIVE_DEFAULT=false

# Resource limits for the per-session sandbox container.
SABER_SANDBOX_MEMORY_LIMIT=4g
SABER_SANDBOX_CPU_LIMIT=2

# Maximum lifetime of a session container in seconds.
SABER_SANDBOX_CONTAINER_TIMEOUT=7200

# ----------------------------------------------------------
# Metasploit / MSFRPC
# ----------------------------------------------------------

# Used by scripts/start_msfrpc.sh and the Metasploit wrapper.
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55552
MSF_RPC_USER=msf
MSF_RPC_PASSWORD=
MSF_RPC_SSL=false

# ----------------------------------------------------------
# OWASP ZAP
# ----------------------------------------------------------

# Used by scripts/start_zap.sh and the ZAP API wrapper.
ZAP_API_HOST=127.0.0.1
ZAP_API_PORT=8080
ZAP_API_KEY=

# ----------------------------------------------------------
# OpenVAS / GVM
# ----------------------------------------------------------

# Optional. Only required if OpenVAS/GVM integration is enabled.
GVM_HOST=127.0.0.1
GVM_PORT=9390
GVM_USERNAME=
GVM_PASSWORD=

# ----------------------------------------------------------
# Active Directory Lab Defaults
# ----------------------------------------------------------

# Optional defaults for lab environments. Production values should be supplied
# through scope.yaml / roe.yaml rather than hardcoded here.
AD_DOMAIN=
AD_DOMAIN_CONTROLLER=
AD_TEST_USERNAME=
AD_TEST_PASSWORD=
AD_TEST_CREDENTIALS=

# ----------------------------------------------------------
# Reporting Metadata
# ----------------------------------------------------------

# Optional defaults used in generated reports.
SABER_REPORT_OPERATOR=
SABER_REPORT_CLIENT=
SABER_REPORT_CLASSIFICATION=CONFIDENTIAL