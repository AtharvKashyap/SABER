# ==========================================================
# SABER Environment Example
# Copy to .env and fill in local values.
# Never commit your real .env file.
# ==========================================================

# ----------------------------------------------------------
# Agent Mode
# ----------------------------------------------------------
# deterministic = rule-based fallback, no LLM key required
# llm = use the configured model for agent decisions
SABER_AGENT_MODE=llm

# ----------------------------------------------------------
# Model
# ----------------------------------------------------------
# disabled = no model, deterministic mode only
# openrouter:<model> = hosted model through OpenRouter
# local:<model> = locally hosted model gateway
#
# Examples:
# SABER_MODEL=disabled
# SABER_MODEL=openrouter:anthropic/claude-3.5-sonnet
# SABER_MODEL=openrouter:anthropic/claude-3.7-sonnet
# SABER_MODEL=openrouter:anthropic/claude-sonnet-4
# SABER_MODEL=local:llama3.1:8b
# SABER_MODEL=local:qwen2.5-coder:14b
SABER_MODEL=openrouter:anthropic/claude-3.5-sonnet

# Required only for hosted models.
# Leave empty for local models.
SABER_MODEL_API_KEY=

# Required only for local models.
# Examples:
# SABER_LOCAL_MODEL_URL=http://127.0.0.1:11434/v1
# SABER_LOCAL_MODEL_URL=http://127.0.0.1:4000/v1
SABER_LOCAL_MODEL_URL=

# ----------------------------------------------------------
# SABER Runtime
# ----------------------------------------------------------
SABER_SESSION_DIR=sessions
SABER_OUTPUT_DIR=output
SABER_LOG_LEVEL=INFO

# ----------------------------------------------------------
# Sandbox
# ----------------------------------------------------------
# docker = run tools in SABER Kali sandbox container
# local = run tools directly on this machine
SABER_SANDBOX_BACKEND=docker
SABER_SANDBOX_IMAGE=ghcr.io/atharvkashyap/saber-sandbox:kali-last-release
SABER_INTERACTIVE_DEFAULT=true

# ----------------------------------------------------------
# Optional Local Tool Services
# Fill only if you start these services.
# ----------------------------------------------------------
MSF_RPC_PASSWORD=
ZAP_API_KEY=
GVM_USERNAME=
GVM_PASSWORD=

# ----------------------------------------------------------
# Report Defaults
# ----------------------------------------------------------
SABER_REPORT_OPERATOR=
SABER_REPORT_CLIENT=
SABER_REPORT_CLASSIFICATION=CONFIDENTIAL
# ----------------------------------------------------------
# Docker Runtime Advanced
# ----------------------------------------------------------
# host works best on Linux. Docker Desktop may emulate this differently.
SABER_DOCKER_NETWORK=host

# Leave empty to use image default user.
SABER_DOCKER_USER=

# ----------------------------------------------------------
# Gated E2E / Acceptance Tests
# ----------------------------------------------------------
# These flags opt in to slow, real-world tests that are SKIPPED by default.
#
# SABER_RUN_DOCKER_E2E = run Docker-backed E2E tests (real sandbox + tools).
# SABER_RUN_LLM_E2E    = run the live-model mission-loop acceptance tests.
#   The live-LLM acceptance tests require BOTH SABER_RUN_LLM_E2E=1 and
#   SABER_RUN_DOCKER_E2E=1, plus a configured model + key, plus Docker. They
#   make real model API calls, so keep them off (0) unless you intend to run
#   them locally (see `make llm-e2e`).
SABER_RUN_DOCKER_E2E=0
SABER_RUN_LLM_E2E=0

# Optional: bound the live acceptance loop (default 8 steps).
# SABER_E2E_MAX_STEPS=8

# Optional CTF acceptance target. No reproducible local CTF box ships with
# SABER, so the CTF acceptance test only runs when you point it at an
# authorized, locally-runnable vulnerable box. SABER_CTF_PROFILE defaults to
# "network".
# SABER_CTF_TARGET=127.0.0.1:8080
# SABER_CTF_PROFILE=network
